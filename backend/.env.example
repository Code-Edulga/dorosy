# Copy to .env and fill in. Keys: Paymob dashboard → Settings → API Keys (toggle Test Mode for test keys).
PORT=4000

# Public HTTPS address of this server. Paymob posts the webhook here and sends the parent's browser back through it.
# In development, run a tunnel (for example `ngrok http 4000`) and paste its URL.
PUBLIC_URL=https://your-tunnel.ngrok-free.app

PAYMOB_SECRET_KEY=egy_sk_test_...
PAYMOB_PUBLIC_KEY=egy_pk_test_...
# Dashboard → Settings → Account Info → HMAC. This is not the API key.
PAYMOB_HMAC_SECRET=

# Dashboard → Developers → Payment Integrations. Leave one empty to turn that method off.
# Test integration IDs only work with test keys, and live IDs with live keys.
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_KIOSK=

# Optional
# Paymob requires an email on every payment; parents sign in by phone, so this is used instead.
# PAYMOB_FALLBACK_EMAIL=payments@dorosy.app
# PAYMOB_API_BASE=https://accept.paymob.com
# PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/
# DATABASE_PATH=data/dorosy.db
# SEED_DEMO_DATA=true
# Web preview origin allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:8081
# Links the backend may send the browser back to after checkout (app scheme, Expo Go, web preview).
# APP_RETURN_URL_PREFIXES=dorosy://,exp://,http://localhost:8081/
